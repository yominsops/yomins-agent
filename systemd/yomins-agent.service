[Unit]
Description=Yomins Metrics Agent
Documentation=https://docs.yominsops.com/agent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120s
StartLimitBurst=5

[Service]
Type=simple
User=yomins-agent
Group=yomins-agent
# Allows reading the system journal (needed for journald auth-log fallback).
SupplementaryGroups=systemd-journal

# Load token and server URL from this file.
# Create it with: echo "YOMINS_SERVER=...\nYOMINS_TOKEN=..." > /etc/yomins-agent/env
EnvironmentFile=-/etc/yomins-agent/env

# Run as root (+ prefix) before the main process starts.
# Applies a staged upgrade or rolls back a failed one.
ExecStartPre=+/usr/local/lib/yomins-agent/apply-upgrade.sh

ExecStart=/usr/local/bin/yomins-agent

# systemd automatically creates /var/lib/yomins/agent and sets ownership
# to the service user. This is where agent_id is persisted.
StateDirectory=yomins/agent
StateDirectoryMode=0700

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# read-only, not true: application logs often live under /home/*/logs.
ProtectHome=read-only
ReadOnlyPaths=/
ReadWritePaths=/var/lib/yomins/agent

# Restart=always so that a clean exit (os.Exit(0)) after staging an upgrade
# also triggers a restart, allowing apply-upgrade.sh to apply the new binary.
Restart=always
RestartSec=10s

# Give the agent time to flush on shutdown.
TimeoutStopSec=15s

# CAP_SYSLOG: read /dev/kmsg (OOM kills).
# CAP_DAC_READ_SEARCH: read log files whatever their owner and mode (many are
# root:root 0600, Docker's are under a root-only directory). It grants
# reading only, never writing; the agent itself reads logs only inside its
# allow list (YOMINS_LOG_ALLOW, default /var/log/** and app log dirs).
AmbientCapabilities=CAP_SYSLOG CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_SYSLOG CAP_DAC_READ_SEARCH
# Required for reading from journald
SupplementaryGroups=systemd-journal adm shadow

[Install]
WantedBy=multi-user.target
